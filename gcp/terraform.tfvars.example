# Copy to terraform.tfvars to run this root by hand. The pipeline passes these as
# TF_VAR_* from GitHub Actions secrets instead.

project_id = "casa-ahun"
region     = "us-central1"

# From the shared IaC repo: terraform output spring_datasource_urls
spring_datasource_url      = "jdbc:postgresql://db.<duty-ref>.supabase.co:5432/ahun_duty_service"
spring_datasource_password = "your-supabase-db-password"

telegram_chat_id = "-1001234567890"

# From the shared IaC repo: terraform output -raw bot_token_secret
bot_token_secret_id = "ahun-telegram-bot-token"
